        { from: 'Adobe Premiere Pro', to: 'Kdenlive', lic: 'GPL-3.0', cat: 'Video', plat: 'Win · Mac · Linux', note: 'Multitrack video editor with effects and proxies.', url: 'https://kdenlive.org' },
