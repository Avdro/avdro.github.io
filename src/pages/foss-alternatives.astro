        { from: 'QuickBooks', to: 'GnuCash', lic: 'GPL-3.0', cat: 'Office & Docs', plat: 'Win · Mac · Linux', note: 'Double-entry accounting for small business and home.', url: 'https://www.gnucash.org' },
        { from: 'Google Forms', to: 'LimeSurvey', lic: 'GPL-3.0', cat: 'Office & Docs', plat: 'Web · Self-hosted', note: 'Surveys and questionnaires with full data ownership.', url: 'https://www.limesurvey.org' },
        { from: 'Calendly', to: 'Cal.com', lic: 'AGPL-3.0', cat: 'Office & Docs', plat: 'Web · Self-hosted', note: 'Scheduling links for individuals and teams.', url: 'https://cal.com' },
