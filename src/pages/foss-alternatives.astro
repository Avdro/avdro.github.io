        { from: 'Notion', to: 'AppFlowy', lic: 'AGPL-3.0', cat: 'Notes & Tasks', plat: 'Win · Mac · Linux', note: 'Wikis, docs and databases with offline sync.', url: 'https://appflowy.io' },
        { from: 'Evernote', to: 'Joplin', lic: 'AGPL-3.0', cat: 'Notes & Tasks', plat: 'Win · Mac · Linux', note: 'Notebooks with web clipping and end-to-end sync.', url: 'https://joplinapp.org' },
        { from: 'Microsoft OneNote', to: 'Joplin', lic: 'AGPL-3.0', cat: 'Notes & Tasks', plat: 'Win · Mac · Linux', note: 'Hierarchical notebooks that import Evernote files.', url: 'https://joplinapp.org' },
        { from: 'Obsidian', to: 'Logseq', lic: 'AGPL-3.0', cat: 'Notes & Tasks', plat: 'Win · Mac · Linux', note: 'Outliner with local Markdown files and backlinks.', url: 'https://logseq.com' },
        { from: 'Todoist', to: 'Super Productivity', lic: 'MIT', cat: 'Notes & Tasks', plat: 'Win · Mac · Linux · Web', note: 'Task board with time tracking and Pomodoro.', url: 'https://super-productivity.com' },
        { from: 'Pocket', to: 'Wallabag', lic: 'MIT', cat: 'Notes & Tasks', plat: 'Web · Self-hosted', note: 'Save articles to read later, ad-free.', url: 'https://wallabag.org' },
        { from: 'Feedly', to: 'FreshRSS', lic: 'AGPL-3.0', cat: 'Notes & Tasks', plat: 'Web · Self-hosted', note: 'Self-hosted RSS reader with a mobile-friendly UI.', url: 'https://freshrss.org' },
        { from: 'Duolingo', to: 'Anki', lic: 'AGPL-3.0', cat: 'Notes & Tasks', plat: 'Win · Mac · Linux · Web', note: 'Spaced-repetition flashcards that really stick.', url: 'https://apps.ankiweb.net' },
        { from: 'Slack', to: 'Zulip', lic: 'Apache-2.0', cat: 'Communication', plat: 'Web · Self-hosted', note: 'Threaded team chat that stays readable.', url: 'https://zulip.com' },
        { from: 'Zoom', to: 'Jitsi Meet', lic: 'Apache-2.0', cat: 'Communication', plat: 'Web · Self-hosted', note: 'Video conferences with no account needed.', url: 'https://jitsi.org' },
        { from: 'Microsoft Teams', to: 'Jitsi Meet', lic: 'Apache-2.0', cat: 'Communication', plat: 'Web · Self-hosted', note: 'Meetings and screen sharing you can self-host.', url: 'https://jitsi.org' },
        { from: 'WhatsApp', to: 'Signal', lic: 'AGPL-3.0', cat: 'Communication', plat: 'Desktop · Mobile', note: 'End-to-end encrypted messaging from a non-profit.', url: 'https://signal.org' },
        { from: 'Discord', to: 'Element', lic: 'Apache-2.0', cat: 'Communication', plat: 'Web · Desktop · Mobile', note: 'Communities on the decentralised Matrix network.', url: 'https://element.io' },
        { from: 'Gmail', to: 'Thunderbird', lic: 'MPL-2.0', cat: 'Communication', plat: 'Win · Mac · Linux', note: 'Desktop email, calendar and chat in one app.', url: 'https://www.thunderbird.net' },
        { from: 'Dropbox', to: 'Syncthing', lic: 'MPL-2.0', cat: 'Cloud & Sync', plat: 'Win · Mac · Linux', note: 'Peer-to-peer folder sync with no cloud middleman.', url: 'https://syncthing.net' },
        { from: 'Google Drive', to: 'Nextcloud', lic: 'AGPL-3.0', cat: 'Cloud & Sync', plat: 'Self-hosted', note: 'Files, calendar, contacts and office in one server.', url: 'https://nextcloud.com' },
        { from: 'Google Photos', to: 'Immich', lic: 'AGPL-3.0', cat: 'Cloud & Sync', plat: 'Self-hosted', note: 'Mobile photo backup with face recognition.', url: 'https://immich.app' },
        { from: '1Password', to: 'Bitwarden', lic: 'GPL-3.0', cat: 'Security & Privacy', plat: 'All platforms', note: 'Password manager with apps for every device.', url: 'https://bitwarden.com' },
        { from: 'LastPass', to: 'KeePassXC', lic: 'GPL-3.0', cat: 'Security & Privacy', plat: 'Win · Mac · Linux', note: 'Offline password vault — nothing leaves your disk.', url: 'https://keepassxc.org' },
        { from: 'Google Chrome', to: 'Firefox', lic: 'MPL-2.0', cat: 'Security & Privacy', plat: 'Win · Mac · Linux · Mobile', note: 'The independent browser backed by a non-profit.', url: 'https://www.mozilla.org' },
        { from: 'Google Maps', to: 'Organic Maps', lic: 'GPL-3.0', cat: 'Security & Privacy', plat: 'Desktop · Mobile', note: 'Fully offline maps and navigation on OpenStreetMap data.', url: 'https://organicmaps.app' },
        { from: 'Google Translate', to: 'LibreTranslate', lic: 'AGPL-3.0', cat: 'Security & Privacy', plat: 'Web · Self-hosted', note: 'Machine translation you can self-host.', url: 'https://libretranslate.com' },
        { from: 'Grammarly', to: 'LanguageTool', lic: 'LGPL-2.1', cat: 'Security & Privacy', plat: 'Web · Desktop', note: 'Grammar and style checking for 30+ languages.', url: 'https://languagetool.org' },
        { from: 'VS Code', to: 'VSCodium', lic: 'MIT', cat: 'Developer Tools', plat: 'Win · Mac · Linux', note: 'VS Code binaries without Microsoft telemetry.', url: 'https://vscodium.com' },
        { from: 'Sublime Text', to: 'Kate', lic: 'GPL-3.0', cat: 'Developer Tools', plat: 'Win · Mac · Linux', note: 'Fast editor with split views and LSP support.', url: 'https://kate-editor.org' },
        { from: 'Postman', to: 'Hoppscotch', lic: 'MIT', cat: 'Developer Tools', plat: 'Web · Self-hosted', note: 'Lightweight API testing for REST and GraphQL.', url: 'https://hoppscotch.io' },
        { from: 'Docker Desktop', to: 'Podman Desktop', lic: 'GPL-2.0', cat: 'Developer Tools', plat: 'Win · Mac · Linux', note: 'Daemonless containers without license fees.', url: 'https://podman-desktop.io' },
        { from: 'MongoDB', to: 'PostgreSQL', lic: 'PostgreSQL License', cat: 'Developer Tools', plat: 'Win · Mac · Linux', note: 'The world\'s most advanced open-source database.', url: 'https://www.postgresql.org' },
        { from: 'VMware Workstation', to: 'VirtualBox', lic: 'GPL-2.0', cat: 'Developer Tools', plat: 'Win · Mac · Linux', note: 'Virtual machines for any guest operating system.', url: 'https://www.virtualbox.org' },
        { from: 'GitHub Copilot', to: 'Tabby', lic: 'Apache-2.0', cat: 'Developer Tools', plat: 'Self-hosted', note: 'Self-hosted AI coding assistant, your models.', url: 'https://tabby.tabbyml.com' },
        { from: 'Netflix', to: 'Jellyfin', lic: 'GPL-3.0', cat: 'Media & Streaming', plat: 'Self-hosted', note: 'Stream your own media collection to TVs and phones.', url: 'https://jellyfin.org' },
        { from: 'Plex', to: 'Jellyfin', lic: 'GPL-3.0', cat: 'Media & Streaming', plat: 'Self-hosted', note: 'Media server with no accounts and no upsells.', url: 'https://jellyfin.org' },
        { from: 'WinRAR', to: '7-Zip', lic: 'LGPL-2.1', cat: 'Everyday Tools', plat: 'Win · Mac · Linux', note: 'The archive manager that opens everything.', url: 'https://www.7-zip.org' },
        { from: 'WinZip', to: '7-Zip', lic: 'LGPL-2.1', cat: 'Everyday Tools', plat: 'Win · Mac · Linux', note: 'Fast compression with the 7z format.', url: 'https://www.7-zip.org' },
        { from: 'uTorrent', to: 'qBittorrent', lic: 'GPL-2.0', cat: 'Everyday Tools', plat: 'Win · Mac · Linux', note: 'Ad-free torrent client with search and RSS.', url: 'https://www.qbittorrent.org' }
    ]

    const CATS = [...new Set(DATA.map((d) => d.cat))]

    const listEl = document.getElementById('alt-list') as HTMLElement
    const countEl = document.getElementById('f-count') as HTMLElement
    const catsEl = document.getElementById('f-cats') as HTMLElement
    const searchEl = document.getElementById('f-search') as HTMLInputElement
    const sortEl = document.getElementById('f-sort') as HTMLSelectElement

    let q = ''
    let cat = 'All'

    const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string))

    const filtered = () => {
        let items = DATA.filter(
            (a) =>
                (cat === 'All' || a.cat === cat) &&
                (q === '' || (a.from + ' ' + a.to + ' ' + a.note).toLowerCase().includes(q))
        )
        if (sortEl.value === 'az') items = items.sort((a, b) => a.from.localeCompare(b.from))
        else if (sortEl.value === 'za') items = items.sort((a, b) => b.from.localeCompare(a.from))
        else items = items.sort((a, b) => a.cat.localeCompare(b.cat) || a.from.localeCompare(b.from))
        return items
    }

    const renderChips = () => {
        const names = ['All', ...CATS]
        catsEl.innerHTML = names
            .map((c) => {
                const active = c === cat
                const cls = active
                    ? 'rounded-full px-3 py-1 text-sm bg-stone-900 text-white dark:bg-white dark:text-stone-900'
                    : 'rounded-full px-3 py-1 text-sm border border-stone-300 dark:border-stone-700 hover:border-stone-500 transition-colors'
                return `<button data-cat='${esc(c)}' class='${cls}'>${esc(c)}</button>`
            })
            .join('')
        catsEl.querySelectorAll('button').forEach((b) =>
            b.addEventListener('click', () => {
                cat = (b as HTMLElement).dataset.cat || 'All'
                renderChips()
                render()
            })
        )
    }

    const render = () => {
        const items = filtered()
        countEl.textContent = `Showing ${items.length} of ${DATA.length} alternatives`
        if (!items.length) {
            listEl.innerHTML = ''
            countEl.textContent = 'No matches — try a shorter search term.'
            return
        }
        listEl.innerHTML = items
            .map(
                (a) => `
                <div class='rounded-lg border border-stone-200 dark:border-stone-800 p-5'>
                    <p class='text-xs uppercase tracking-wide text-stone-400 dark:text-stone-500'>${esc(a.cat)}</p>
                    <p class='mt-1 break-words'>
                        <span class='text-stone-500 dark:text-stone-400'>${esc(a.from)}</span>
                        <span class='mx-1.5 text-stone-400'>→</span>
                        <a href='${esc(a.url)}' target='_blank' rel='noopener noreferrer'
                            class='text-lg font-semibold text-emerald-700 dark:text-emerald-400 hover:underline'>${esc(a.to)}</a>
                    </p>
                    <p class='text-sm text-stone-600 dark:text-stone-300 mt-1'>${esc(a.note)}</p>
                    <p class='text-xs text-stone-500 dark:text-stone-400 mt-2 flex flex-wrap items-center gap-x-2 gap-y-1'>
                        <span class='rounded border border-stone-300 dark:border-stone-700 px-1.5 py-0.5'>${esc(a.lic)}</span>
                        <span>${esc(a.plat)}</span>
                    </p>
                </div>`
            )
            .join('')
    }

    searchEl.addEventListener('input', () => {
        q = searchEl.value.trim().toLowerCase()
        render()
    })
    sortEl.addEventListener('change', render)
    renderChips()
    render()
</script>
