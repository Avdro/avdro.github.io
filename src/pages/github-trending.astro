---
import BaseLayout from '@/layouts/BaseLayout'
---

<BaseLayout
    title='Trending Open Source on GitHub'
    description='The hottest open-source repositories on GitHub right now — computed live in your browser, filtered to proper open-source licenses.'
>
    <h1 class='text-center text-4xl md:text-6xl font-semibold my-8'>
        Trending on GitHub
    </h1>

    <p class='text-center text-stone-600 dark:text-stone-300 max-w-3xl mx-auto -mt-2 mb-8'>
        The hottest open-source repositories on GitHub right now, computed live in your browser from the
        public GitHub API — and filtered to genuine open-source licenses only.
    </p>

    <div class='flex flex-wrap justify-center items-center gap-x-6 gap-y-3 my-8'>
        <label class='text-sm text-stone-600 dark:text-stone-300'>
            Range
            <select
                id='f-range'
                class='ml-2 rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-[#0a0910] px-2 py-1'
            >
                <option value='week'>This week</option>
                <option value='month'>This month</option>
                <option value='all'>All time</option>
            </select>
        </label>
        <label class='text-sm text-stone-600 dark:text-stone-300'>
            Language
            <select
                id='f-lang'
                class='ml-2 rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-[#0a0910] px-2 py-1'
            >
                <option value='any'>Any</option>
                <option>JavaScript</option>
                <option>TypeScript</option>
                <option>Python</option>
                <option>Rust</option>
                <option>Go</option>
                <option>C</option>
                <option>C++</option>
                <option>C#</option>
                <option>Java</option>
                <option>PHP</option>
                <option>Ruby</option>
                <option>Shell</option>
                <option>Zig</option>
            </select>
        </label>
    </div>

    <div id='trending-list' class='grid gap-4 md:grid-cols-2 not-prose'></div>
    <p id='trending-status' class='text-center text-sm text-stone-500 dark:text-stone-400 my-6'></p>

    <p class='text-center text-sm text-stone-500 dark:text-stone-400 mt-10'>
        Results are cached on your device for 30 minutes. Nothing is stored on our side.
    </p>

    <article class='prose prose-lg md:prose-xl dark:prose-invert min-w-full py-10'>
        <h2>What does “trending” mean here?</h2>
        <p>
            GitHub's own trending page is curated and changes without explanation. This list is
            different: it is computed live in your browser from the public GitHub Search API, using
            rules you can verify. <strong>This week</strong> ranks repositories created in the last
            7 days by the stars they collected (at least 30). <strong>This month</strong> does the
            same for the last 30 days (at least 100 stars). <strong>All time</strong> ranks every
            repository above 50,000 stars — the all-time greats.
        </p>

        <h2>Why only certain licenses?</h2>
        <p>
            Every repository shown carries a recognized open-source license: MIT, Apache-2.0, the
            GPL family, BSD, MPL, ISC and a few others. Repositories with no license or with a
            proprietary one are filtered out, so everything on this list is genuinely free software
            you can legally use, study, modify and share.
        </p>

        <h2>How to read each card</h2>
        <ul>
            <li>The number is its position in the list; the avatar shows the developer or organisation behind it.</li>
            <li><strong>★ n</strong> is the star count — how many people bookmarked the project.</li>
            <li>The colored dot is the main programming language; the badge is the license.</li>
            <li><strong>Updated</strong> is the date of the last push: recent pushes mean active maintenance.</li>
        </ul>

        <h2>Tips</h2>
        <p>
            The list is fresh on every visit and cached on your device for 30 minutes. Filtering by
            a language is the fastest way to discover new libraries for your stack. If GitHub's
            rate limit (60 requests per hour per IP) is reached, the page will tell you — wait a
            few minutes and reload.
        </p>
    </article>
</BaseLayout>

<script>
    const OSI = new Set([
        'MIT', 'Apache-2.0', 'GPL-2.0', 'GPL-3.0', 'AGPL-3.0', 'LGPL-2.1', 'LGPL-3.0',
        'BSD-2-Clause', 'BSD-3-Clause', 'MPL-2.0', 'EPL-2.0', 'ISC', 'Unlicense',
        'CC0-1.0', 'Zlib', 'EUPL-1.2', 'BSL-1.0', 'CECILL-B'
    ])

    const LANG_COLORS: Record<string, string> = {
        JavaScript: '#f1e05a', TypeScript: '#3178c6', Python: '#3572A5', Rust: '#dea584',
        Go: '#00ADD8', C: '#555555', 'C++': '#f34b7d', 'C#': '#178600', Java: '#b07219',
        PHP: '#4F5D95', Ruby: '#701516', Shell: '#89e051', Zig: '#ec915c', Vue: '#41b883',
        HTML: '#e34c26', CSS: '#563d7c', 'Jupyter Notebook': '#DA5B0B'
    }

    const listEl = document.getElementById('trending-list') as HTMLElement
    const statusEl = document.getElementById('trending-status') as HTMLElement
    const rangeEl = document.getElementById('f-range') as HTMLSelectElement
    const langEl = document.getElementById('f-lang') as HTMLSelectElement

    const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string))

    const fmtStars = (n: number) =>
        n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n)

    const since = (days: number) => new Date(Date.now() - days * 86400000).toISOString().slice(0, 10)

    const buildQuery = (range: string, lang: string) => {
        let q = ''
        if (range === 'week') q = `created:>${since(7)} stars:>30`
        else if (range === 'month') q = `created:>${since(30)} stars:>100`
        else q = 'stars:>50000'
        if (lang !== 'any') q += ` language:${lang}`
        return q
    }

    interface Repo {
        name: string; url: string; desc: string; stars: number
        lang: string; lic: string; updated: string; avatar: string
    }

    const render = (items: Repo[]) => {
        listEl.innerHTML = items
            .map((r, i) => {
                const color = LANG_COLORS[r.lang] || '#8b8b8b'
                const desc = r.desc.length > 180 ? r.desc.slice(0, 177) + '…' : r.desc
                return `
                <div class='rounded-lg border border-stone-200 dark:border-stone-800 p-5'>
                    <div class='flex items-start gap-3'>
                        <span class='text-lg font-semibold text-stone-400 dark:text-stone-600 w-6 shrink-0'>${i + 1}</span>
                        <img src='${esc(r.avatar)}' alt='' loading='lazy' class='rounded-full w-10 h-10 shrink-0' />
                        <div class='min-w-0'>
                            <a href='${esc(r.url)}' target='_blank' rel='noopener noreferrer'
                                class='font-semibold break-words hover:underline'>${esc(r.name)}</a>
                            ${desc ? `<p class='text-sm text-stone-600 dark:text-stone-300 mt-1'>${esc(desc)}</p>` : ''}
                            <p class='text-sm text-stone-500 dark:text-stone-400 mt-2 flex flex-wrap items-center gap-x-3 gap-y-1'>
                                <span>★ ${fmtStars(r.stars)}</span>
                                ${r.lang ? `<span class='inline-flex items-center gap-1'><span class='inline-block w-3 h-3 rounded-full' style='background:${color}'></span>${esc(r.lang)}</span>` : ''}
                                <span class='rounded border border-stone-300 dark:border-stone-700 px-1.5 py-0.5 text-xs'>${esc(r.lic)}</span>
                                ${r.updated ? `<span>Updated ${esc(r.updated)}</span>` : ''}
                            </p>
                        </div>
                    </div>
                </div>`
            })
            .join('')
    }

    const load = async () => {
        const range = rangeEl.value
        const lang = langEl.value
        const cacheKey = `getfoss:trend:${range}:${lang}`
        const cached = localStorage.getItem(cacheKey)
        if (cached) {
            try {
                const c = JSON.parse(cached)
                if (Date.now() - c.t < 30 * 60 * 1000) {
                    render(c.items)
                    statusEl.textContent = ''
                    return
                }
            } catch {
                /* ignore bad cache */
            }
        }
        listEl.innerHTML = ''
        statusEl.textContent = 'Loading trending repositories…'
        try {
            const q = buildQuery(range, lang)
            const url = `https://api.github.com/search/repositories?q=${encodeURIComponent(q)}&sort=stars&order=desc&per_page=100`
            const res = await fetch(url, { headers: { Accept: 'application/vnd.github+json' } })
            if (!res.ok) throw new Error('GitHub API error ' + res.status)
            const data = await res.json()
            const items: Repo[] = (data.items || [])
                .filter((r: any) => r.license && r.license.spdx_id && OSI.has(r.license.spdx_id))
                .slice(0, 30)
                .map((r: any) => ({
                    name: r.full_name,
                    url: r.html_url,
                    desc: r.description || '',
                    stars: r.stargazers_count,
                    lang: r.language || '',
                    lic: r.license.spdx_id,
                    updated: (r.pushed_at || '').slice(0, 10),
                    avatar: r.owner?.avatar_url || ''
                }))
            if (!items.length) {
                statusEl.textContent = 'No repositories found for this filter. Try another range or language.'
                return
            }
            render(items)
            statusEl.textContent = ''
            try {
                localStorage.setItem(cacheKey, JSON.stringify({ t: Date.now(), items }))
            } catch {
                /* storage unavailable */
            }
        } catch {
            statusEl.textContent =
                'Could not load data from GitHub (rate limit or network issue). Please try again in a few minutes.'
        }
    }

    rangeEl.addEventListener('change', load)
    langEl.addEventListener('change', load)
    load()
</script>
